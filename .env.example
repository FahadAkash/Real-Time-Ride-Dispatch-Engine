# Environment configuration template (No secrets in git)
APP_ENV=local
HTTP_ADDR=:8080
GRPC_ADDR=:9090
LOG_LEVEL=info
METRICS_ADDR=:9100          # internal-only /metrics listener, never public

JWT_ISSUER=dispatch-auth
JWT_AUDIENCE=dispatch-engine
JWKS_URL=
JWT_ALLOWED_ALGS=RS256,ES256

REDIS_ADDRS=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

MONGO_URI=mongodb://localhost:27017
MONGO_DB=dispatch

KAFKA_BROKERS=localhost:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TLS=false

FCM_CREDENTIALS_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=

DISPATCH_CANDIDATES=10
DRIVER_LOCK_TTL=15s
OFFER_TIMEOUT=15s
MAX_REASSIGN_ATTEMPTS=3
LOCATION_STALE_AFTER=30s
RATE_LIMIT_RIDE_REQUEST_PER_MIN=60
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Observability stack env vars
GRAFANA_ADMIN_PASSWORD=admin
MONGODB_EXPORTER_URI=mongodb://localhost:27017
REDIS_EXPORTER_ADDR=redis://redis:6379
REDIS_EXPORTER_PASSWORD=
KAFKA_EXPORTER_BROKER=kafka:9092

